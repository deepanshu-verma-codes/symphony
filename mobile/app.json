{
  "expo": {
    "name": "Symphony",
    "slug": "symphony",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/symphony.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.deepanshuvermacodes.symphony"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/symphony.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/symphony.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deepanshuvermacodes.symphony"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/symphony.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/symphony.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56352ecd-1d51-46c0-a68a-3ada92af0807"
      }
    }
  }
}
